# ----------------------------------------------------------------------------
# Mergence — environment variables
# Copy this file to ".env" (or ".env.local") and fill in your keys.
# The app runs WITHOUT any keys using curated sample data; add keys for live data.
# ----------------------------------------------------------------------------

# PRIMARY data source — Financial Modeling Prep (free tier ~250 calls/day).
# Sign up at https://site.financialmodelingprep.com -> Dashboard -> copy API key.
FMP_API_KEY=

# News source for RUMORED deals — Marketaux (free 100/day).
# Sign up at https://www.marketaux.com -> Dashboard -> API token.
MARKETAUX_API_KEY=

# FREE earnings source (EPS / shares) so the accretion model works on live deals
# without FMP's paid plan. Finnhub free tier: 60 calls/min.
# Sign up at https://finnhub.io -> Dashboard -> API key.
FINNHUB_API_KEY=

# SEC EDGAR requires no key, only a descriptive User-Agent (name + email).
# https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT=Mergence Research your-email@example.com
